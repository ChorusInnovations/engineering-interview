local_resource(
    'backend: build if changed',
    serve_cmd='nx watch --projects pokemon-user-backend -- nx build pokemon-user-backend',
    trigger_mode=TRIGGER_MODE_MANUAL,
    labels=['backend']
)

docker_build(
    'pokemon-user-backend',
    '../../',
    dockerfile='../../packages/pokemon-user-backend/Dockerfile'
)

k8s_yaml(['./k8s/local/deployment.yaml'])

k8s_resource(
    'pokemon-user-backend',
    port_forwards=3000,
    resource_deps=['pokemon-postgres'],
    labels=['backend'],
    links=['http://localhost:3000/api']
)

_pkg_dir = os.path.join(os.getcwd(), 'packages/pokemon-user-backend')
_tsx = os.path.join(os.getcwd(), 'node_modules/.bin/tsx')
_mikro_orm_cli = os.path.join(os.getcwd(), 'node_modules/@mikro-orm/cli/cli.js')

local_resource(
    'db: migration:up',
    cmd='%s %s migration:up' % (_tsx, _mikro_orm_cli),
    resource_deps=['pokemon-postgres'],
    labels=['database'],
    dir=_pkg_dir
)

local_resource(
    'db: migration:create',
    cmd='%s %s migration:create' % (_tsx, _mikro_orm_cli),
    resource_deps=['pokemon-postgres'],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
    labels=['database'],
    dir=_pkg_dir
)
