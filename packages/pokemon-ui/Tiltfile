docker_build(
    'pokemon-ui',
    '../../',
    dockerfile='./Dockerfile',
    live_update=[
        sync('../../packages/pokemon-ui/src', '/app/packages/pokemon-ui/src'),
    ]
)

k8s_yaml(['./k8s/local/deployment.yaml'])

k8s_resource(
    'pokemon-ui',
    port_forwards=4200,
    labels=['frontend'],
    links=['http://localhost:4200']
)
